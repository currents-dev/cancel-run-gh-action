{
  "name": "cancel-run-gh-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub action that cancels a Currents run when the workflow that recorded it is cancelled",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run format-check && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/currents-dev/cancel-run-gh-action.git"
  },
  "keywords": [
    "actions",
    "currents",
    "cypress",
    "playwright"
  ],
  "author": "Currents Software Inc.",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
